<Project Sdk="Microsoft.NET.Sdk">

  <!-- NativeAOT app that links the internalized libimpeller.a next to SkiaSharp and HarfBuzzSharp.
       dotnet publish -c Release -r linux-x64 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <ImpellerLinkMode>Static</ImpellerLinkMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Import Project="../Sandbox/Impeller.targets" />

  <ItemGroup>
    <EmbeddedResource Include="../Sandbox.Web/Assets/NotoSans-Regular.ttf" LogicalName="NotoSans-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.148.0" />
    <!-- NoDependencies: no libfontconfig, so it also runs under qemu with a bare aarch64 sysroot. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.148.0" />
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/NImpeller/NImpeller.csproj" />
  </ItemGroup>

</Project>
