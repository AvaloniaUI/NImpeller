<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Directory.Build.props sets net10.0; clear it so the TargetFrameworks below apply. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-ios;net10.0-tvos;net10.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-tvos'))">16.0</SupportedOSPlatformVersion>
    <!-- .NET 10 apps need Mac Catalyst 17.0; impeller.framework itself runs on 15.0. -->
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-maccatalyst'))">17.0</SupportedOSPlatformVersion>
    <RootNamespace>Sandbox.Apple</RootNamespace>
    <ApplicationId>com.avaloniaui.nimpeller.sandbox</ApplicationId>
    <ApplicationTitle>NImpeller Sandbox</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sandbox.Core/Sandbox.Core.csproj" />
    <ProjectReference Include="../../src/NImpeller/NImpeller.csproj" />
  </ItemGroup>

  <!-- Embeds impeller.framework from external/impeller_sdk/<platform>/frameworks. -->
  <Import Project="Impeller.targets" />

</Project>
