<Project>
  <!--
    Packages libimpeller.so for each Android RuntimeIdentifier from external/impeller_sdk/<rid>/lib.
    impeller-builder ships the libraries stripped; the symbols are in the -symbols archives.
  -->
  <PropertyGroup>
    <ImpellerSdkDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'external', 'impeller_sdk'))</ImpellerSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <_ImpellerAndroidAbi Include="android-arm64" Rid="android-arm64" Abi="arm64-v8a" />
    <_ImpellerAndroidAbi Include="android-arm" Rid="android-arm" Abi="armeabi-v7a" />
    <_ImpellerAndroidAbi Include="android-x64" Rid="android-x64" Abi="x86_64" />
  </ItemGroup>

  <Target Name="_AddImpellerAndroidLibraries" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_ImpellerRids>;$(RuntimeIdentifiers);$(RuntimeIdentifier);</_ImpellerRids>
    </PropertyGroup>
    <ItemGroup>
      <_ImpellerAndroidLibrary Include="@(_ImpellerAndroidAbi->'$(ImpellerSdkDirectory)%(Rid)/lib/libimpeller.so')"
                               Condition="$(_ImpellerRids.Contains(';%(Rid);'))" />
    </ItemGroup>
    <Error Condition="!Exists('%(_ImpellerAndroidLibrary.FullPath)')"
           Text="Impeller SDK not found at %(_ImpellerAndroidLibrary.FullPath). Run: ./build.sh DownloadImpeller --rid %(_ImpellerAndroidLibrary.Rid)" />
    <ItemGroup>
      <AndroidNativeLibrary Include="@(_ImpellerAndroidLibrary)" Abi="%(_ImpellerAndroidLibrary.Abi)" />
    </ItemGroup>
  </Target>
</Project>
