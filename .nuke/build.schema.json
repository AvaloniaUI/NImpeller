{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "Host": {
      "type": "string",
      "enum": [
        "AppVeyor",
        "AzurePipelines",
        "Bamboo",
        "Bitbucket",
        "Bitrise",
        "GitHubActions",
        "GitLab",
        "Jenkins",
        "Rider",
        "SpaceAutomation",
        "TeamCity",
        "Terminal",
        "TravisCI",
        "VisualStudio",
        "VSCode"
      ]
    },
    "ExecutableTarget": {
      "type": "string",
      "enum": [
        "Clean",
        "Compile",
        "DownloadImpeller",
        "DownloadLatestImpeller",
        "GenerateBindings",
        "ListImpellerCommits",
        "Pack",
        "ResolveFlutterVersion",
        "Restore"
      ]
    },
    "Verbosity": {
      "type": "string",
      "description": "",
      "enum": [
        "Verbose",
        "Normal",
        "Minimal",
        "Quiet"
      ]
    },
    "NukeBuild": {
      "properties": {
        "Continue": {
          "type": "boolean",
          "description": "Indicates to continue a previously failed build attempt"
        },
        "Help": {
          "type": "boolean",
          "description": "Shows the help text for this build assembly"
        },
        "Host": {
          "description": "Host for execution. Default is 'automatic'",
          "$ref": "#/definitions/Host"
        },
        "NoLogo": {
          "type": "boolean",
          "description": "Disables displaying the NUKE logo"
        },
        "Partition": {
          "type": "string",
          "description": "Partition to use on CI"
        },
        "Plan": {
          "type": "boolean",
          "description": "Shows the execution plan (HTML)"
        },
        "Profile": {
          "type": "array",
          "description": "Defines the profiles to load",
          "items": {
            "type": "string"
          }
        },
        "Root": {
          "type": "string",
          "description": "Root directory during build execution"
        },
        "Skip": {
          "type": "array",
          "description": "List of targets to be skipped. Empty list skips all dependencies",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Target": {
          "type": "array",
          "description": "List of targets to be invoked. Default is '{default_target}'",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Verbosity": {
          "description": "Logging verbosity during build execution. Default is 'Normal'",
          "$ref": "#/definitions/Verbosity"
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "All": {
          "type": "boolean",
          "description": "Download all platforms"
        },
        "Configuration": {
          "type": "string",
          "description": "Configuration to build - Default is 'Debug' (local) or 'Release' (server)",
          "enum": [
            "Debug",
            "Release"
          ]
        },
        "Extract": {
          "type": "boolean",
          "description": "Extract downloaded files"
        },
        "FlutterRef": {
          "type": "string",
          "description": "Flutter tag or commit to package (default: latest stable tag)"
        },
        "FlutterRemote": {
          "type": "string",
          "description": "Git remote of the Flutter checkout to fetch tags from (default: upstream)"
        },
        "FlutterRoot": {
          "type": "string",
          "description": "Path to a flutter/flutter checkout (default: ../flutter)"
        },
        "ImpellerSha": {
          "type": "string",
          "description": "Flutter commit SHA for Impeller SDK download"
        },
        "IncludeHost": {
          "type": "boolean",
          "description": "Also download the SDK for the current host platform (native library for local runs)"
        },
        "KeepZip": {
          "type": "boolean",
          "description": "Keep zip files after extraction"
        },
        "NoFetch": {
          "type": "boolean",
          "description": "Do not fetch tags from the Flutter remote"
        },
        "Platform": {
          "type": "string",
          "description": "Platform to download (linux-x64, darwin-arm64, etc.)"
        },
        "Revision": {
          "type": "integer",
          "description": "Binding revision on top of the same Flutter release (stable: 4th version part, beta: last prerelease part)",
          "format": "int32"
        }
      }
    },
    {
      "$ref": "#/definitions/NukeBuild"
    }
  ]
}
