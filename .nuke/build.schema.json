{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "Host": {
      "type": "string",
      "enum": [
        "AppVeyor",
        "AzurePipelines",
        "Bamboo",
        "Bitbucket",
        "Bitrise",
        "GitHubActions",
        "GitLab",
        "Jenkins",
        "Rider",
        "SpaceAutomation",
        "TeamCity",
        "Terminal",
        "TravisCI",
        "VisualStudio",
        "VSCode"
      ]
    },
    "ExecutableTarget": {
      "type": "string",
      "enum": [
        "BumpImpeller",
        "Clean",
        "Compile",
        "CompileShaders",
        "DownloadImpeller",
        "GenerateBindings",
        "Pack",
        "Restore"
      ]
    },
    "Verbosity": {
      "type": "string",
      "description": "",
      "enum": [
        "Verbose",
        "Normal",
        "Minimal",
        "Quiet"
      ]
    },
    "NukeBuild": {
      "properties": {
        "Continue": {
          "type": "boolean",
          "description": "Indicates to continue a previously failed build attempt"
        },
        "Help": {
          "type": "boolean",
          "description": "Shows the help text for this build assembly"
        },
        "Host": {
          "description": "Host for execution. Default is 'automatic'",
          "$ref": "#/definitions/Host"
        },
        "NoLogo": {
          "type": "boolean",
          "description": "Disables displaying the NUKE logo"
        },
        "Partition": {
          "type": "string",
          "description": "Partition to use on CI"
        },
        "Plan": {
          "type": "boolean",
          "description": "Shows the execution plan (HTML)"
        },
        "Profile": {
          "type": "array",
          "description": "Defines the profiles to load",
          "items": {
            "type": "string"
          }
        },
        "Root": {
          "type": "string",
          "description": "Root directory during build execution"
        },
        "Skip": {
          "type": "array",
          "description": "List of targets to be skipped. Empty list skips all dependencies",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Target": {
          "type": "array",
          "description": "List of targets to be invoked. Default is '{default_target}'",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Verbosity": {
          "description": "Logging verbosity during build execution. Default is 'Normal'",
          "$ref": "#/definitions/Verbosity"
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "All": {
          "type": "boolean",
          "description": "All RIDs of the lock file"
        },
        "Builder": {
          "type": "string",
          "description": "GitHub repository of the impeller-builder releases - Default is the lock's, or AvaloniaUI/impeller-builder"
        },
        "BuilderDir": {
          "type": "string",
          "description": "Read the archives from a local impeller-builder release/ folder instead of the pinned release"
        },
        "Configuration": {
          "type": "string",
          "description": "Configuration to build - Default is 'Debug' (local) or 'Release' (server)",
          "enum": [
            "Debug",
            "Release"
          ]
        },
        "Rid": {
          "type": "string",
          "description": "RID of the Impeller SDK (linux-x64, osx-arm64, win-x64, android-arm64, ...) - Default is the host"
        },
        "Symbols": {
          "type": "boolean",
          "description": "Also unpack the debug symbols archive"
        },
        "Tag": {
          "type": "string",
          "description": "impeller-builder release tag to pin, <flutter version>-<sha10>"
        },
        "Tools": {
          "type": "boolean",
          "description": "Also unpack the tools archive (impellerc), desktop RIDs only"
        }
      }
    },
    {
      "$ref": "#/definitions/NukeBuild"
    }
  ]
}
