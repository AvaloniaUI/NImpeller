<Project>
    <PropertyGroup>
        <!-- Third-party submodules under external/ manage their own versions. -->
        <ManagePackageVersionsCentrally Condition="!$(MSBuildProjectDirectory.Replace('\', '/').Contains('/external/'))">true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- Library / generator -->
    <ItemGroup>
        <PackageVersion Include="ClangSharp" Version="[18.1.0.4]" />
        <PackageVersion Include="libclang.runtime.linux-x64" Version="[18.1.3.2]" />
        <PackageVersion Include="libclang.runtime.win-x64" Version="[18.1.3.2]" />
        <PackageVersion Include="libclang.runtime.osx-x64" Version="[18.1.3]" />
        <PackageVersion Include="libclang.runtime.osx-arm64" Version="[18.1.3]" />
        <PackageVersion Include="libclangsharp.runtime.linux-x64" Version="[18.1.3.1]" />
        <PackageVersion Include="libclangsharp.runtime.win-x64" Version="[18.1.3.1]" />
        <PackageVersion Include="libclangsharp.runtime.osx-x64" Version="[18.1.3.1]" />
        <PackageVersion Include="libclangsharp.runtime.osx-arm64" Version="[18.1.3.1]" />
    </ItemGroup>

    <!-- Build (Nuke) -->
    <ItemGroup>
        <PackageVersion Include="Nuke.Common" Version="10.1.0" />
        <!-- Transitive pins: Nuke.Common 10.1.0 still pulls vulnerable versions of these.
             NuGet.Packaging also tracks the NuGet bundled with the pinned SDK (7.9.x for 10.0.4xx);
             an older NuGet.Frameworks breaks Nuke's in-process MSBuild evaluation. -->
        <PackageVersion Include="NuGet.Packaging" Version="7.9.0" />
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
        <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    </ItemGroup>

    <!-- Tests -->
    <ItemGroup>
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>

    <!-- Samples / shared -->
    <ItemGroup>
        <PackageVersion Include="CommandLineParser" Version="2.9.1" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageVersion Include="SharpMetal" Version="1.1.0" />
        <PackageVersion Include="Silk.NET.GLFW" Version="2.22.0" />
        <PackageVersion Include="Silk.NET.OpenGL" Version="2.22.0" />
        <PackageVersion Include="Silk.NET.OpenGLES" Version="2.22.0" />
        <PackageVersion Include="Silk.NET.SDL" Version="2.22.0" />
        <PackageVersion Include="Silk.NET.Vulkan" Version="2.22.0" />
        <PackageVersion Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.22.0" />
        <PackageVersion Include="Spectre.Console" Version="0.54.0" />
    </ItemGroup>
</Project>
